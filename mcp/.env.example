# openlawfirm-mcp environment configuration
# Copy to .env and fill in real values for local development.

# Server
PORT=3825
NODE_ENV=development

# OpenLawFirm API base URL (the Express backend at server/)
OPENLAWFIRM_API_BASE_URL=http://localhost:3024

# openscaffold-oauth (the shared OAuth 2.0 authorization server)
# JWKS endpoint used to validate access tokens
OSO_JWKS_URL=http://localhost:4000/jwks
OSO_ISSUER=http://localhost:4000
OSO_AUDIENCE=openlawfirm-mcp-claude-connector

# OpenLawFirm session JWT bridge — used to mint HS256 session tokens for the
# OpenLawFirm REST API from validated OAuth tokens. Must match the JWT_SECRET
# set in the OpenLawFirm server. In production, replace with service-to-
# service auth (mutual TLS or signed service tokens).
OLF_JWT_SECRET=dev-shared-jwt-secret-openlawfirm-2026-do-not-use-in-production

# Database connection for the user-lookup step in the auth bridge.
# Shared with the rest of the ecosystem.
DATABASE_URL=postgresql://localhost:5432/openfirehouse

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://claude.ai,https://claude.com,http://localhost:8765

# Logging
LOG_LEVEL=info
