# openlawfirm-mcp environment configuration
# Copy to .env and fill in real values for local development.

# Server
PORT=3825
NODE_ENV=development

# OpenLawFirm API base URL (the Express backend at server/)
OPENLAWFIRM_API_BASE_URL=http://localhost:3024

# openscaffold-oauth (the shared OAuth 2.0 authorization server)
# JWKS endpoint used to validate access tokens
OSO_JWKS_URL=http://localhost:4000/.well-known/jwks.json
OSO_ISSUER=https://auth.openscaffoldlabs.com
OSO_AUDIENCE=openlawfirm

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# Logging
LOG_LEVEL=info
